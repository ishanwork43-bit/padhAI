# Copy to .env for a fresh setup; preserve an existing .env when upgrading.
# Optional: leave blank for local retrieval only. Never commit a real key.
# AI requests occur only after clicking Generate AI answer or Generate quiz.
OPENAI_API_KEY=
# Used by answers and quizzes; must support strict JSON-schema Chat Completions.
OPENAI_MODEL=gpt-4o-mini
# Per-file accepted upload limit in MiB (1 MiB = 1,048,576 bytes), integer 1–50.
# Separate from Streamlit's transport upload setting.
MAX_UPLOAD_MB=10
