# Server-only settings. Read deployment instructions before using production mode.
API_ENV=development
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_DATABASE_PATH=data/padhai.sqlite3
WORKSPACE_TTL_SECONDS=86400
MAX_WORKSPACES=100
ENABLE_PAID_AI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUESTS_PER_WORKSPACE=5
AI_REQUESTS_PER_DAY=50
